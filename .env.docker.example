APP_NAME="UniWorld Holidays"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
COMPOSE_PROJECT_NAME=uniworld-holidays
APP_PORT=127.0.0.1:8081

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bobby_holidays
DB_USERNAME=bobby_user
DB_PASSWORD=replace_with_a_long_random_password
DB_ROOT_PASSWORD=replace_with_a_different_long_random_password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_long_random_redis_password

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_DEMO_SEEDING=false
PRIVACY_POLICY_VERSION=2026-09-16
